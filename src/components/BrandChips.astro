---
// Крупные кнопки-чипы с марками.
// На странице /parts клик подставляет марку в форму запроса (и прокручивает к ней).
// На других страницах чип — ссылка на /parts?brand=<марка>#parts-form, форма подхватит марку сама.
import { BRANDS } from '../config/site.js';

interface Props {
  mode?: 'form' | 'link';
}
const { mode = 'form' } = Astro.props;
const chipClass =
  'inline-flex items-center justify-center min-h-[48px] px-5 py-3 rounded-full border-2 border-gray-200 bg-white text-gray-800 text-base md:text-lg font-semibold hover:border-indigo-600 hover:text-indigo-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 transition';
---
<div class="flex flex-wrap gap-3">
  {BRANDS.map((brand) =>
    mode === 'form' ? (
      <button type="button" class={chipClass} data-brand-chip={brand}>{brand}</button>
    ) : (
      <a href={`/parts?brand=${encodeURIComponent(brand)}#parts-form`} class={chipClass}>{brand}</a>
    )
  )}
</div>
