---
// Форма запроса запчасти без бэкенда: собирает поля в текст и открывает WhatsApp отдела запчастей.
// При отправке — цель Метрики «parts_form_submit», выбранная марка уходит в параметры визита.
import { PHONES, BRANDS } from '../config/site.js';

const waNumber = PHONES.parts.wa;
const photoText = encodeURIComponent('Здравствуйте! Не знаю артикул — пришлю фото детали. Марка и модель погрузчика: ');
const inputClass =
  'w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-base text-gray-900 placeholder-gray-400 focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-200';
---
<form id="parts-form" class="bg-white text-left text-gray-900 rounded-2xl shadow-xl p-5 md:p-8 max-w-2xl mx-auto scroll-mt-28" data-wa={waNumber} novalidate>
  <h2 class="text-xl md:text-2xl font-bold mb-1">Запрос запчасти</h2>
  <p class="text-gray-500 text-sm mb-5">Заполните поля — откроется WhatsApp отдела запчастей с готовым сообщением.</p>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <label class="block">
      <span class="block text-sm font-semibold text-gray-700 mb-1">Марка</span>
      <select name="brand" class={inputClass}>
        <option value="">Выберите марку</option>
        {BRANDS.map((b) => <option value={b}>{b}</option>)}
        <option value="Другая">Другая марка</option>
      </select>
    </label>
    <label class="block">
      <span class="block text-sm font-semibold text-gray-700 mb-1">Модель</span>
      <input name="model" type="text" autocomplete="off" placeholder="Например, 7FGK20" class={inputClass} />
    </label>
    <label class="block sm:col-span-2">
      <span class="block text-sm font-semibold text-gray-700 mb-1">Деталь или артикул <span class="text-red-600">*</span></span>
      <input name="part" type="text" autocomplete="off" required placeholder="Например, помпа или 16100-78156-71" class={inputClass} />
      <span class="hidden mt-1 text-sm text-red-600" data-error>Укажите деталь или артикул</span>
    </label>
  </div>

  <button type="submit" class="mt-5 w-full inline-flex items-center justify-center bg-green-600 hover:bg-green-700 text-white font-bold text-lg py-4 px-6 rounded-xl shadow-lg transition">
    Отправить запрос в WhatsApp
  </button>

  <p class="mt-4 text-center text-sm">
    <a href={`https://wa.me/${waNumber}?text=${photoText}`} target="_blank" rel="noopener" class="text-indigo-700 font-semibold underline underline-offset-2 hover:text-indigo-900">
      Не знаете артикул? Пришлите фото детали
    </a>
  </p>
</form>

<script is:inline>
  (function () {
    var form = document.getElementById('parts-form');
    if (!form) return;
    var brandSelect = form.elements.brand;
    var partInput = form.elements.part;
    var error = form.querySelector('[data-error]');

    function setBrand(brand) {
      if (!brand) return;
      var exists = Array.prototype.some.call(brandSelect.options, function (o) { return o.value === brand; });
      brandSelect.value = exists ? brand : 'Другая';
    }

    // Марка из адреса: /parts?brand=Toyota (переход с чипов на главной)
    try { setBrand(new URLSearchParams(location.search).get('brand')); } catch (e) {}

    // Клик по чипу марки на этой странице
    document.addEventListener('click', function (e) {
      var chip = e.target.closest('[data-brand-chip]');
      if (!chip) return;
      setBrand(chip.getAttribute('data-brand-chip'));
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      setTimeout(function () { form.elements.model.focus({ preventScroll: true }); }, 400);
    });

    partInput.addEventListener('input', function () { error.classList.add('hidden'); });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var brand = brandSelect.value.trim();
      var model = form.elements.model.value.trim();
      var part = partInput.value.trim();
      if (!part) {
        error.classList.remove('hidden');
        partInput.focus();
        return;
      }
      var lines = ['Здравствуйте! Нужна запчасть для погрузчика.'];
      if (brand) lines.push('Марка: ' + brand);
      if (model) lines.push('Модель: ' + model);
      lines.push('Деталь / артикул: ' + part);
      var url = 'https://wa.me/' + form.dataset.wa + '?text=' + encodeURIComponent(lines.join('\n'));

      if (window.lifterGoal) {
        window.lifterGoal('parts_form_submit', { parts_brand: brand || 'не указана' }, true);
      }
      // Открываем WhatsApp в новой вкладке; если браузер заблокировал — в этой же
      var win = window.open(url, '_blank');
      if (win) { win.opener = null; } else { location.href = url; }
    });
  })();
</script>
