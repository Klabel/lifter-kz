---
import '../styles/global.css';
import { PHONES, ADDRESS, YM_ID } from '../config/site.js';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const {
  title,
  description = "Продажа и сервис вилочных погрузчиков в Астане, Караганде и по Казахстану.",
  image = "/images/og-default.jpg",
  canonical = Astro.url.href,
} = Astro.props;
---

<!doctype html>
<html lang="ru">
	<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site).toString()} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="ForkliftService" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site).toString()} />

    <!-- Schema.org LocalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "ForkliftService",
      "description": description,
      "url": Astro.site,
      "telephone": PHONES.service.tel,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": ADDRESS.street,
        "addressLocality": ADDRESS.city,
        "postalCode": ADDRESS.postalCode,
        "addressCountry": ADDRESS.country
      },
      "areaServed": ["Астана", "Караганда", "Алматы", "Казахстан"]
    })} />

    <!-- Fonts (optimized for performance) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet"></noscript>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-N14S8FRZMD"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-N14S8FRZMD');
      gtag('config', 'AW-960707991');
    </script>

    <!-- Yandex.Metrika: ID берётся из PUBLIC_YM_ID при сборке; без него счётчик не подключается -->
    {YM_ID && (
      <script is:inline define:vars={{ ymId: Number(YM_ID) }}>
        (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();
        for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
        k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
        (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");
        window.LIFTER_YM_ID = ymId;
        ym(ymId, "init", {
          clickmap: true,
          trackLinks: true,
          accurateTrackBounce: true,
          webvisor: true
        });
      </script>
    )}
</head>
	<body class="font-inter text-gray-900 bg-gray-50 flex flex-col min-h-screen">
		{YM_ID && (
			<noscript><div><img src={`https://mc.yandex.ru/watch/${YM_ID}`} style="position:absolute; left:-9999px;" alt="" width="1" height="1" /></div></noscript>
		)}

		<!-- Header -->
		<header class="bg-white shadow-md sticky top-0 z-50">
			<div class="container mx-auto px-4 py-3 md:py-4 flex flex-col xl:flex-row justify-between items-center gap-4">

				<!-- Logo & City -->
				<div class="flex items-center gap-4 w-full md:w-auto justify-between md:justify-start">
					<a href="/" class="text-2xl font-black text-indigo-800 tracking-tighter uppercase">
						Forklift<span class="text-blue-600">Service</span>
					</a>
					<div class="hidden xl:block h-8 w-px bg-gray-300"></div>
					<div class="text-sm text-gray-600 hidden xl:block">
						<span class="block font-bold text-gray-800">Астана / Караганда / Алматы</span>
						Работаем по всему KZ
					</div>
				</div>

				<!-- Navigation (Desktop) -->
				<nav id="desktop-nav" class="hidden xl:flex gap-6 font-medium text-gray-700">
					<a href="/" class="hover:text-indigo-700 transition">Главная</a>
					<a href="/catalog" class="hover:text-indigo-700 transition">Каталог техники</a>
					<a href="/repair" class="hover:text-indigo-700 transition">Ремонт и Сервис</a>
					<a href="/tires" class="hover:text-indigo-700 transition">Перепрессовка</a>
					<a href="/parts" class="hover:text-indigo-700 transition">Запчасти</a>
				</nav>

				<!-- Contacts & CTA -->
				<div class="flex items-center w-full justify-between md:w-auto md:flex-col md:items-end md:gap-2">
					<div class="text-right">
						<a href={`tel:${PHONES.service.tel}`} class="block text-lg md:text-xl font-bold text-gray-900 hover:text-indigo-700 transition whitespace-nowrap">
							{PHONES.service.display}
						</a>
						<span class="text-xs font-medium block"><span class="text-gray-500">{PHONES.service.label}</span> · <span class="text-green-600">Сейчас работаем</span></span>
					</div>
					<a href={`https://wa.me/${PHONES.service.wa}`} target="_blank" class="border-2 border-green-600 text-green-700 hover:bg-green-50 text-sm font-bold py-2 px-4 rounded-lg transition md:w-full md:text-center">
						WhatsApp
					</a>
				</div>
			</div>

			<!-- Mobile Nav -->
			<div id="mobile-nav" class="xl:hidden border-t border-gray-100 flex justify-around py-2 bg-gray-50 text-sm font-medium text-gray-600">
				<a href="/" class="p-2 hover:text-indigo-700">Главная</a>
				<a href="/catalog" class="p-2 hover:text-indigo-700">Каталог</a>
				<a href="/repair" class="p-2 hover:text-indigo-700">Ремонт</a>
				<a href="/tires" class="p-2 hover:text-indigo-700">Шины</a>
				<a href="/parts" class="p-2 hover:text-indigo-700">Запчасти</a>
			</div>
		</header>

		<!-- Main Content -->
		<main class="flex-grow">
			<slot />
		</main>

		<!-- Footer -->
		<footer class="bg-gray-900 text-white py-12">
			<div class="container mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8 text-center md:text-left">
				<div>
					<div class="text-2xl font-black mb-4">Forklift<span class="text-blue-500">Service</span></div>
					<p class="text-gray-400 mb-4">Продажа, аренда и ремонт вилочных погрузчиков. Запчасти и сервисное обслуживание по всему Казахстану.</p>

                    <!-- Legal Info for Google Ads Verification -->
                    <div class="text-xs text-gray-500 border-t border-gray-800 pt-4 mt-4 space-y-1">
                        <p class="font-bold text-gray-400">Владелец сайта: ИП Бублик Николай Витальевич</p>
                        <p>Адрес: {ADDRESS.postalCode}, Казахстан, г. {ADDRESS.city}, {ADDRESS.street}</p>
                        <p>Контакты: {PHONES.service.display}</p>
                    </div>
				</div>
				<div>
					<h3 class="text-lg font-bold mb-4 text-gray-200">Услуги</h3>
					<ul class="space-y-2 text-gray-400">
						<li><a href="/" class="hover:text-white transition">Продажа погрузчиков</a></li>
						<li><a href="/repair" class="hover:text-white transition">Ремонт и ТО</a></li>
						<li><a href="/tires" class="hover:text-white transition">Перепрессовка шин</a></li>
						<li><a href="/parts" class="hover:text-white transition">Запчасти</a></li>
					</ul>
				</div>
				<div>
					<h3 class="text-lg font-bold mb-4 text-gray-200">Контакты</h3>
					<div class="mb-4">
						<span class="block text-xs uppercase tracking-wide text-gray-500">{PHONES.service.label}</span>
						<a href={`tel:${PHONES.service.tel}`} class="block text-2xl font-bold hover:text-blue-400 transition">{PHONES.service.display}</a>
					</div>
					<div class="mb-4">
						<span class="block text-xs uppercase tracking-wide text-gray-500">{PHONES.parts.label}</span>
						<a href={`tel:${PHONES.parts.tel}`} class="block text-2xl font-bold hover:text-blue-400 transition">{PHONES.parts.display}</a>
					</div>
					<p class="text-gray-400 mb-4">Астана / Караганда</p>
					<div class="flex justify-center md:justify-start gap-4">
						<a href={`https://wa.me/${PHONES.service.wa}`} target="_blank" class="text-green-500 hover:text-green-400 font-bold">WhatsApp</a>
						<a href="https://t.me/+77017230470" class="text-blue-500 hover:text-blue-400 font-bold">Telegram</a>
					</div>
				</div>
			</div>
		</footer>

        <!-- Conversion tracking: phone and WhatsApp separately -->
        <script is:inline define:vars={{ partsWa: PHONES.parts.wa }}>
            document.addEventListener('DOMContentLoaded', () => {
                const phoneLinks = document.querySelectorAll('a[href^="tel:"]');
                phoneLinks.forEach(link => {
                    link.addEventListener('click', function() {
                        if (typeof gtag === 'function') {
                            gtag('event', 'phone_click', {
                                'event_category': 'contact',
                                'event_label': 'phone'
                            });
                            gtag('event', 'conversion', {
                                'send_to': 'AW-960707991/_XiRCJ-Uz5gcEJI7jMoD',
                                'value': 1.0,
                                'currency': 'USD'
                            });
                        }
                    });
                });

                // Тип WhatsApp: parts — номер запчастей, tires — страница шин, service — остальное (номер сервиса)
                function waType(link) {
                    const explicit = link.getAttribute('data-wa-goal'); // например, wa_tires
                    if (explicit) return explicit.replace(/^wa_/, '');
                    if ((link.getAttribute('href') || '').indexOf(partsWa) !== -1) return 'parts';
                    if (location.pathname.indexOf('/tires') === 0) return 'tires';
                    return 'service';
                }

                const waLinks = document.querySelectorAll('a[href*="wa.me"], a[href*="whatsapp"]');
                waLinks.forEach(link => {
                    link.addEventListener('click', function() {
                        if (typeof gtag === 'function') {
                            const type = waType(link);
                            // Название события прежнее — чтобы не терять историю; тип — в параметре wa_type
                            gtag('event', 'whatsapp_click', {
                                'event_category': 'contact',
                                'event_label': 'whatsapp_' + type,
                                'wa_type': type
                            });
                            gtag('event', 'conversion', {
                                'send_to': 'AW-960707991/_XiRCJ-Uz5gcEJI7jMoD',
                                'value': 1.0,
                                'currency': 'USD'
                            });
                        }
                    });
                });
            });
        </script>

        <!-- Яндекс Метрика: цели по кликам и «внимание к блоку» -->
        <script is:inline define:vars={{ phones: PHONES }}>
            // Безопасная отправка цели: если Метрика не подключена — просто ничего не делаем.
            window.lifterGoal = function (goal, params, asVisitParams) {
                var id = window.LIFTER_YM_ID;
                if (!id || typeof window.ym !== 'function') return;
                if (asVisitParams && params) window.ym(id, 'params', params);
                window.ym(id, 'reachGoal', goal, params || undefined);
            };

            function digits(s) { return (s || '').replace(/\D/g, ''); }

            // Клики по телефонам и WhatsApp (делегирование — работает для всех ссылок на странице)
            document.addEventListener('click', function (e) {
                var a = e.target.closest && e.target.closest('a[href]');
                if (!a) return;
                var href = a.getAttribute('href');

                if (href.indexOf('tel:') === 0) {
                    var num = digits(href);
                    var goal = num === digits(phones.parts.tel) ? phones.parts.goal
                             : num === digits(phones.service.tel) ? phones.service.goal
                             : 'phone_other';
                    window.lifterGoal(goal);
                    return;
                }

                if (/wa\.me|whatsapp/i.test(href)) {
                    // Явно заданная цель важнее автоопределения
                    var waGoal = a.getAttribute('data-wa-goal');
                    if (!waGoal) {
                        if (href.indexOf(phones.parts.wa) !== -1) waGoal = 'wa_parts';
                        else if (location.pathname.indexOf('/tires') === 0) waGoal = 'wa_tires';
                        else waGoal = 'wa_service';
                    }
                    window.lifterGoal(waGoal);
                }
            });

            // «Внимание к блоку»: блок с data-track виден ≥ 3 секунд → цель attention_<имя>, раз за визит
            (function () {
                if (!('IntersectionObserver' in window)) return;
                var DELAY = 3000;
                var KEY = 'lifter_attention_sent';
                var sent = {};
                try { sent = JSON.parse(sessionStorage.getItem(KEY) || '{}'); } catch (e) {}
                function markSent(name) {
                    sent[name] = 1;
                    try { sessionStorage.setItem(KEY, JSON.stringify(sent)); } catch (e) {}
                }
                var timers = new Map();
                var observer = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        var el = entry.target;
                        var name = el.getAttribute('data-track');
                        // «Виден» = половина блока на экране, либо блок занимает половину экрана (для высоких блоков)
                        var visible = entry.isIntersecting && (
                            entry.intersectionRatio >= 0.5 ||
                            entry.intersectionRect.height >= window.innerHeight * 0.5
                        );
                        if (visible && !timers.has(el) && !sent[name]) {
                            timers.set(el, setTimeout(function () {
                                timers.delete(el);
                                if (sent[name]) return;
                                if (!window.LIFTER_YM_ID) return; // без Метрики не помечаем — отправим, когда подключится
                                markSent(name);
                                window.lifterGoal('attention_' + name, { block: name });
                                observer.unobserve(el);
                            }, DELAY));
                        } else if (!visible && timers.has(el)) {
                            clearTimeout(timers.get(el));
                            timers.delete(el);
                        }
                    });
                }, { threshold: Array.from({ length: 21 }, function (_, i) { return i / 20; }) });

                function start() {
                    document.querySelectorAll('[data-track]').forEach(function (el) {
                        if (!sent[el.getAttribute('data-track')]) observer.observe(el);
                    });
                }
                if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
                else start();
            })();
        </script>

        <!-- Active link highlighting -->
        <script is:inline>
            document.addEventListener('DOMContentLoaded', () => {
                const currentPath = window.location.pathname;
                const navLinks = document.querySelectorAll('#desktop-nav a, #mobile-nav a');

                navLinks.forEach(link => {
                    const linkHref = link.getAttribute('href');
                    if (linkHref === '/' && currentPath === '/') {
                        link.classList.add('active-link');
                    } else if (linkHref !== '/' && currentPath.startsWith(linkHref)) {
                        link.classList.add('active-link');
                    }
                });
            });
        </script>

	</body>
</html>

<style>
	/* Custom scrollbar for better look */
	::-webkit-scrollbar {
		width: 10px;
	}
	::-webkit-scrollbar-track {
		background: #f1f1f1;
	}
	::-webkit-scrollbar-thumb {
		background: #888;
		border-radius: 5px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: #555;
	}

    .active-link {
        color: #4f46e5; /* indigo-700 */
        font-weight: 700;
    }
</style>