---
import Layout from '../layouts/Layout.astro';
import Track from '../components/Track.astro';
import Clients from '../components/Clients.astro';
import BrandChips from '../components/BrandChips.astro';
import { PHONES } from '../config/site.js';
import { REVIEWS, PHOTOS } from '../data/trust.js';
---

<Layout
  title="Ремонт и обслуживание вилочных погрузчиков в Казахстане — Астана, Караганда | lifter.kz"
  description="Сервисный центр вилочных погрузчиков в Астане и Караганде. Выездной ремонт, ТО, запчасти, шины. Работаем с Toyota, Komatsu, Linde, Hyster и другими марками."
>

  <!-- Schema.org: Organization -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "ForkliftService",
    "url": "https://lifter.kz",
    "telephone": "+77017230470",
    "description": "Ремонт и обслуживание вилочных погрузчиков в Казахстане",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Караганда",
      "addressCountry": "KZ"
    },
    "areaServed": "KZ",
    "sameAs": []
  }
  </script>

  <!-- Hero Section -->
  <section class="relative bg-indigo-900 text-white py-24">
    <div class="absolute inset-0 opacity-20 bg-[url('https://placehold.co/1920x1080/1e1b4b/ffffff?text=Workshop')] bg-cover bg-center"></div>
    <div class="container mx-auto px-4 relative z-10 text-center">
      <h1 class="text-4xl md:text-6xl font-black leading-tight mb-6">
        Ремонт вилочных погрузчиков в Астане и Караганде
      </h1>
      <p class="text-xl md:text-2xl text-gray-300 mb-8 max-w-3xl mx-auto">
        Выездной сервис, запчасти и шины. Работаем с любой техникой — Toyota, Komatsu, Linde, Hyster и другими марками.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/repair" class="bg-yellow-500 hover:bg-yellow-400 text-gray-900 font-bold text-lg py-4 px-8 rounded-xl shadow-lg transition transform hover:scale-105">
          Вызвать мастера
        </a>
        <a href={`https://wa.me/${PHONES.service.wa}`} target="_blank" class="bg-transparent hover:bg-white/10 border-2 border-white/70 text-white font-bold text-lg py-4 px-8 rounded-xl transition text-center">
          Написать в WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- About Company Section -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-5xl font-black text-gray-900 mb-6">О компании</h2>
        <p class="text-lg text-gray-600 mb-8">
          Мы — специализированный сервисный центр по ремонту и обслуживанию вилочных погрузчиков. Работаем более 10 лет. Наша цель — обеспечить бесперебойную работу вашего парка техники с минимальным простоем.
        </p>
        <p class="text-lg text-gray-600">
          Представительства в трёх ключевых городах Казахстана: <span class="font-bold">Астана, Караганда и Алматы</span>. Выездные бригады работают по всей стране — от Павлодара до Шымкента.
        </p>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <Track name="services">
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-5xl font-black text-gray-900 mb-4">Наши услуги</h2>
        <p class="text-xl text-gray-600">Полный цикл обслуживания вилочных погрузчиков в одном месте</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">

        <div class="bg-white p-8 rounded-xl shadow-md">
          <div class="w-14 h-14 bg-indigo-100 rounded-full flex items-center justify-center mb-4 mx-auto text-indigo-600">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">Ремонт погрузчиков</h3>
          <p class="text-gray-600 mb-4">Выездной ремонт и диагностика за 2 часа. Гидравлика, двигатель, электрика, трансмиссия. 80% поломок устраняем на месте.</p>
          <a href="/repair" class="text-indigo-600 font-semibold hover:underline">Подробнее →</a>
        </div>

        <div class="bg-white p-8 rounded-xl shadow-md">
          <div class="w-14 h-14 bg-indigo-100 rounded-full flex items-center justify-center mb-4 mx-auto text-indigo-600">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">Запчасти</h3>
          <p class="text-gray-600 mb-4">Оригинальные и аналоговые запчасти для всех марок погрузчиков. Собственный склад в Караганде, доставка по всему Казахстану.</p>
          <a href="/parts" class="text-indigo-600 font-semibold hover:underline">Подробнее →</a>
        </div>

        <div class="bg-white p-8 rounded-xl shadow-md">
          <div class="w-14 h-14 bg-indigo-100 rounded-full flex items-center justify-center mb-4 mx-auto text-indigo-600">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" stroke-width="2"/><circle cx="12" cy="12" r="3" stroke-width="2"/></svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">Шины для погрузчиков</h3>
          <p class="text-gray-600 mb-4">Цельнолитые и суперэластичные шины. Установка на прессе в Караганде. Подберём размер и тип под ваши условия работы.</p>
          <a href="/tires" class="text-indigo-600 font-semibold hover:underline">Подробнее →</a>
        </div>

      </div>
    </div>
  </section>
  </Track>

  <!-- Доверие: клиенты и гарантия (вторым экраном под услугами) -->
  <Clients showWarranty />

  <!-- Марки: клик ведёт на /parts с подставленной маркой в форме -->
  <Track name="parts">
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4 max-w-4xl">
      <h2 class="text-3xl font-bold mb-3 text-gray-900">Запчасти для вашей марки</h2>
      <p class="text-gray-600 mb-6">Выберите марку погрузчика — откроется форма запроса запчасти.</p>
      <BrandChips mode="link" />
    </div>
  </section>
  </Track>

  <!-- Отзывы (заглушки — тексты в src/data/trust.js) -->
  <Track name="reviews">
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-10 text-gray-900">Отзывы</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {REVIEWS.map((r) => (
          <figure class="bg-gray-50 border border-gray-100 rounded-2xl p-6 flex flex-col">
            <svg class="w-8 h-8 text-indigo-300 mb-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9.5 6C6.5 7 5 9.5 5 13v5h5v-5H7.5c0-2 1-3.5 2.5-4.2L9.5 6zm9 0c-3 1-4.5 3.5-4.5 7v5h5v-5h-2.5c0-2 1-3.5 2.5-4.2L18.5 6z"/></svg>
            <blockquote class={`flex-grow ${r.text ? 'text-gray-700' : 'text-gray-400 italic'}`}>
              {r.text || 'Отзыв скоро появится'}
            </blockquote>
            {(r.name || r.company) && (
              <figcaption class="mt-4 text-sm">
                <span class="font-bold text-gray-900">{r.name}</span>
                {r.company && <span class="block text-gray-500">{r.company}</span>}
              </figcaption>
            )}
          </figure>
        ))}
      </div>
    </div>
  </section>
  </Track>

  <!-- Фото (места под фото — пути в src/data/trust.js) -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-10 text-gray-900">Наш сервис в фото</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {PHOTOS.map((photo) => (
          <figure>
            {photo.src ? (
              <img
                src={photo.src}
                alt={photo.alt}
                width={photo.width}
                height={photo.height}
                loading="lazy"
                decoding="async"
                class="w-full aspect-[4/3] object-cover rounded-xl bg-gray-200"
              />
            ) : (
              <div class="w-full aspect-[4/3] rounded-xl bg-gray-200 border-2 border-dashed border-gray-300 flex items-center justify-center text-gray-400" role="img" aria-label={photo.alt}>
                <svg class="w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M21 16l-5-5-8 8"/></svg>
              </div>
            )}
            <figcaption class="mt-2 text-center text-sm font-semibold text-gray-700">{photo.title}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Us -->
  <section class="py-16 bg-indigo-900 text-white">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-12">Почему выбирают нас</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-5xl font-black text-yellow-400 mb-2">2 ч</div>
          <div class="text-gray-300">Выезд мастера после звонка</div>
        </div>
        <div>
          <div class="text-5xl font-black text-yellow-400 mb-2">10+</div>
          <div class="text-gray-300">Лет опыта в сервисе погрузчиков</div>
        </div>
        <div>
          <div class="text-5xl font-black text-yellow-400 mb-2">80%</div>
          <div class="text-gray-300">Ремонтов выполняем на месте</div>
        </div>
        <div>
          <div class="text-5xl font-black text-yellow-400 mb-2">3</div>
          <div class="text-gray-300">Города присутствия в Казахстане</div>
        </div>
      </div>
    </div>
  </section>

</Layout>